---
const title = 'Panel de crédito Laya';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root{font-family:'DM Sans',sans-serif;color:#e9eef8;background:#090e18;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-height:100vh}button,input,textarea,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.55;cursor:wait}input,textarea,select{background:#111a29;border:1px solid #2b3b50;border-radius:10px;color:#e9eef8;padding:11px 13px;outline:none}input:focus,textarea:focus,select:focus{border-color:#65d9be;box-shadow:0 0 0 3px #65d9be22}textarea{width:100%;resize:vertical;min-height:108px}label{display:grid;gap:7px;color:#afbed0;font-size:13px;font-weight:700}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Space Grotesk',sans-serif}h1{font-size:27px;letter-spacing:-.04em}h2{font-size:22px;letter-spacing:-.03em}h3{font-size:15px}p{color:#9eafc4;line-height:1.5}.muted{color:#8396ab}.small{font-size:12px}.shell{display:grid;grid-template-columns:244px 1fr;min-height:100vh}.sidebar{background:#0d1420;border-right:1px solid #1c2a3c;padding:26px 18px;display:flex;flex-direction:column;gap:32px}.brand{display:flex;align-items:center;gap:11px;padding:0 9px}.brand-mark{width:34px;height:34px;background:#69dec1;border-radius:11px;color:#082319;display:grid;place-items:center;font-weight:800;font-family:'Space Grotesk';font-size:23px}.brand strong{display:block;font-family:'Space Grotesk';letter-spacing:-.04em}.brand small{color:#7d91a6}.nav{display:grid;gap:6px}.nav button{width:100%;display:flex;align-items:center;gap:12px;text-align:left;background:transparent;border:0;border-radius:10px;color:#9baec3;padding:12px 14px;font-weight:700}.nav button:hover,.nav button.active{background:#17322f;color:#75e6c9}.nav button span{width:21px;text-align:center;font-size:17px}.sidebar-bottom{margin-top:auto;border-top:1px solid #253347;padding-top:18px}.sidebar-bottom button{background:transparent;color:#9eafc4;border:0;padding:8px}.main{padding:36px clamp(22px,4vw,64px);max-width:1500px;width:100%;margin:auto}.topline{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;gap:20px}.eyebrow{text-transform:uppercase;color:#69dec1;letter-spacing:.16em;font-size:11px;font-weight:800;margin-bottom:8px}.status{display:flex;align-items:center;gap:9px;padding:9px 13px;background:#112119;border:1px solid #245244;color:#a7ead6;border-radius:30px;font-size:12px;font-weight:700}.dot{height:8px;width:8px;background:#65e3bc;border-radius:50%}.status.down{background:#2d1a1e;color:#ffb6b8;border-color:#6d3138}.status.down .dot{background:#fa7580}.grid{display:grid;gap:18px}.cards{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:20px}.card,.panel{background:#101a29;border:1px solid #243348;border-radius:17px;box-shadow:0 13px 40px #00000015}.card{padding:21px 23px}.card .label{font-size:12px;color:#8499b0;font-weight:700}.metric{font-family:'Space Grotesk';font-size:28px;font-weight:700;letter-spacing:-.05em;margin:10px 0 0}.metric-sub{font-size:12px;color:#7d92a8;margin-top:6px}.panel{padding:23px}.panel-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:19px;gap:12px}.panel-head h3{margin:0}.two{grid-template-columns:1.5fr 1fr}.bars{height:180px;display:flex;align-items:end;gap:6px;border-bottom:1px solid #314057;padding:10px 0 0}.bar-wrap{flex:1;display:flex;align-items:end;height:100%;min-width:4px}.bar{width:100%;border-radius:5px 5px 0 0;background:linear-gradient(180deg,#75e7c7,#277665);min-height:3px}.bar.error{background:linear-gradient(180deg,#f69597,#8a414c)}.chart-label{display:flex;justify-content:space-between;color:#6d8096;font-size:11px;margin-top:9px}.health-chart{height:180px;display:flex;align-items:center;gap:3px}.health-stick{flex:1;height:68px;background:#377d68;border-radius:3px;max-width:7px}.health-stick.down{background:#ab5260}.health-stick.empty{background:#203045}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;font-size:13px}th{color:#778fa8;text-transform:uppercase;font-size:10px;letter-spacing:.11em;font-weight:800}td,th{padding:14px 10px;border-bottom:1px solid #233246}td{color:#cad5e3}td:first-child,th:first-child{padding-left:0}.pill{border-radius:20px;padding:5px 9px;font-size:11px;font-weight:800;background:#153d34;color:#6de1b6}.pill.bad{background:#4b2730;color:#ff9da3}.content{display:none}.content.active{display:block}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.field-span{grid-column:1/-1}.button{background:#68dec0;color:#09271e;border:0;border-radius:10px;padding:11px 17px;font-weight:800}.button:hover{background:#8af3d8}.button.secondary{background:#1d3041;color:#c9e5e0;border:1px solid #315346}.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.input-row{display:flex;gap:10px}.input-row input{flex:1}.notice{padding:13px 15px;border-radius:9px;margin:14px 0;background:#1b3034;color:#99dcca}.notice.error{background:#392329;color:#ffc4c5}.switch{position:relative;display:inline-block;width:48px;height:27px}.switch input{opacity:0;width:0;height:0}.slider{position:absolute;inset:0;background:#35475b;border-radius:30px;transition:.2s}.slider:before{content:'';position:absolute;width:19px;height:19px;left:4px;top:4px;background:white;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:#59cdaa}.switch input:checked+.slider:before{transform:translateX(21px)}pre{white-space:pre-wrap;word-break:break-word;background:#0a111d;border:1px solid #29394d;border-radius:10px;padding:17px;color:#bde7d9;max-height:550px;overflow:auto;font-size:12px;line-height:1.5}.auth-page{min-height:100vh;display:grid;place-items:center;padding:22px;background:radial-gradient(circle at 70% 12%,#143b38,transparent 40%),#090e18}.auth-card{width:min(100%,430px);padding:36px;background:#101a29;border:1px solid #294355;border-radius:20px;box-shadow:0 25px 80px #0007}.auth-card form{display:grid;gap:16px}.auth-card input{width:100%}.auth-card button{margin-top:5px}.auth-card h1{margin-bottom:7px}.hidden{display:none!important}.company-list{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.company-list button{background:#172738;color:#a8bbcf;border:1px solid #29435a;border-radius:10px;padding:9px 13px}.company-list button.active{color:#113126;background:#7de5c7;border-color:#7de5c7}.helper{font-size:12px;color:#7890a7;margin-top:-3px}.section-description{max-width:700px;margin-bottom:24px}@media(max-width:960px){.cards{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}.shell{grid-template-columns:72px 1fr}.sidebar{padding:22px 10px}.brand strong,.brand small,.nav button .text,.sidebar-bottom{display:none}.brand{padding:0 8px}.nav button{justify-content:center;padding:12px}.main{padding:27px 22px}}@media(max-width:620px){.shell{display:block}.sidebar{position:sticky;top:0;z-index:5;flex-direction:row;align-items:center;padding:9px 12px;border-right:0;border-bottom:1px solid #253347;gap:12px}.nav{display:flex;overflow:auto}.nav button{min-width:43px}.main{padding:25px 15px}.cards,.form-grid{grid-template-columns:1fr}.topline{align-items:flex-start}.panel{padding:17px}}
  </style>
</head>
<body>
  <div id="auth" class="auth-page hidden">
    <div class="auth-card">
      <div class="brand" style="padding:0;margin-bottom:30px"><div class="brand-mark">L</div><div><strong>Laya Crédito</strong><small>Operaciones de decisiones</small></div></div>
      <div id="login-view"><div class="eyebrow">Acceso seguro</div><h1>Bienvenido</h1><p>Inicia sesión para gestionar las decisiones crediticias y la actividad del modelo.</p><form id="login-form"><label>Usuario<input name="username" value="admin" required autocomplete="username" /></label><label>Contraseña<input name="password" type="password" required autocomplete="current-password" /></label><button class="button">Iniciar sesión</button></form></div>
      <div id="password-view" class="hidden"><div class="eyebrow">Primer ingreso</div><h1>Establece una contraseña nueva</h1><p>Cambia la contraseña inicial de administrador para continuar.</p><form id="password-form"><label>Contraseña actual<input name="current_password" type="password" required autocomplete="current-password" /></label><label>Contraseña nueva<input name="new_password" type="password" minlength="12" required autocomplete="new-password" /></label><button class="button">Cambiar contraseña</button></form></div>
      <div id="auth-message"></div>
    </div>
  </div>
  <div id="app" class="shell hidden">
    <aside class="sidebar"><div class="brand"><div class="brand-mark">L</div><div><strong>Laya Crédito</strong><small>Panel de operaciones</small></div></div><nav class="nav" aria-label="Navegación principal"><button class="active" data-tab="overview"><span>▦</span><span class="text">Resumen</span></button><button data-tab="companies"><span>▤</span><span class="text">Empresas</span></button><button data-tab="test"><span>⌁</span><span class="text">Probar modelo</span></button><button data-tab="settings"><span>⚙</span><span class="text">Configuración</span></button></nav><div class="sidebar-bottom"><div class="small muted" style="padding:0 8px 8px">Sesión iniciada como admin</div><button id="logout">↪ &nbsp; Cerrar sesión</button></div></aside>
    <main class="main">
      <section id="overview" class="content active"><div class="topline"><div><div class="eyebrow">Resumen de operaciones</div><h1>Panel del modelo</h1><p style="margin-bottom:0">Estado del servicio y tráfico de decisiones en tiempo real.</p></div><div id="model-status" class="status down"><i class="dot"></i><span>Comprobando modelo</span></div></div><div class="grid cards"><div class="card"><div class="label">Solicitudes totales</div><div class="metric" id="total-requests">0</div><div class="metric-sub">De todas las empresas</div></div><div class="card"><div class="label">Tasa de éxito</div><div class="metric" id="success-rate">—</div><div class="metric-sub">Solicitudes completadas</div></div><div class="card"><div class="label">Latencia promedio</div><div class="metric" id="avg-latency">—</div><div class="metric-sub">Tiempo total de cada llamada</div></div><div class="card"><div class="label">Tokens de entrada</div><div class="metric" id="input-tokens">0</div><div class="metric-sub">Informados por Laya</div></div></div><div class="grid two"><div class="panel"><div class="panel-head"><h3>Tráfico · últimas 24 horas</h3><span class="muted small">Solicitudes por hora</span></div><div id="traffic-bars" class="bars"></div><div class="chart-label"><span>Hace 24 horas</span><span>Ahora</span></div></div><div class="panel"><div class="panel-head"><h3>Disponibilidad del modelo</h3><span class="muted small">Muestras cada minuto</span></div><div id="health-chart" class="health-chart"></div><div class="chart-label"><span>Antes</span><span>Última</span></div></div></div><div class="panel" style="margin-top:18px"><div class="panel-head"><h3>Solicitudes recientes</h3><span class="muted small">Últimas 30</span></div><div class="table-wrap"><table><thead><tr><th>Hora</th><th>Empresa</th><th>Modo</th><th>Estado</th><th>Latencia</th><th>Tokens</th></tr></thead><tbody id="recent-rows"></tbody></table></div></div></section>
      <section id="companies" class="content"><div class="eyebrow">Configuración</div><h1>Empresas y valores predeterminados</h1><p class="section-description">Configura las reglas, opciones de decisión y niveles de rango de cada empresa. Los nombres desconocidos usan los valores de la empresa predeterminada.</p><div class="panel"><div class="panel-head"><h3>Crear empresa</h3></div><form id="create-company" class="input-row"><input name="name" placeholder="Nombre de la empresa" maxlength="80" required /><button class="button">Crear</button></form><div id="company-list" class="company-list"></div><form id="company-form" class="form-grid"><label class="field-span">Reglas <span class="helper">Hasta 5.000 caracteres. Se incluyen en el estado XML si envías historial sin estado.</span><textarea id="company-rules" maxlength="5000" rows="7"></textarea></label><label>Instrucción predeterminada de decisión <span class="helper">Máximo 250 caracteres.</span><input id="company-instruction-decision" maxlength="250" required /></label><label>Instrucción predeterminada de rango <span class="helper">Máximo 250 caracteres.</span><input id="company-instruction-rank" maxlength="250" required /></label><label>Opciones de decisión <span class="helper">Una opción por línea; de 2 a 64 opciones.</span><textarea id="company-options" rows="7"></textarea></label><label>Niveles de rango <span class="helper">Ordenados de menor a mayor; un nivel por línea.</span><textarea id="company-ranks" rows="7"></textarea></label><div class="field-span row"><button class="button">Guardar valores</button><span id="company-message" class="small"></span></div></form></div></section>
      <section id="test" class="content"><div class="eyebrow">Pruebas</div><h1>Probar el modelo</h1><p class="section-description">Envía una solicitud real al modelo. Usa un estado directamente o proporciona un historial para generar un estado XML con las reglas de la empresa.</p><div class="grid two"><div class="panel"><form id="test-form" class="form-grid"><label>Empresa<select id="test-company" name="company"></select></label><label>Salida<select name="output"><option value="both">Decisión y rango</option><option value="decision">Solo decisión</option><option value="rank">Solo rango</option></select></label><label class="field-span">Estado <span class="helper">Opcional si se proporciona historial. Máximo 20.000 caracteres.</span><textarea name="state" maxlength="20000" rows="5" placeholder="Datos del solicitante, evaluación previa u otra información..."></textarea></label><label class="field-span">Historial crediticio <span class="helper">Se usa si el estado está vacío. Máximo 15.000 caracteres.</span><textarea name="history" maxlength="15000" rows="5" placeholder="Historial de pagos y datos crediticios..."></textarea></label><label class="field-span">Reglas para esta solicitud <span class="helper">Opcional; máximo 5.000 caracteres.</span><textarea name="rules" maxlength="5000" rows="3" placeholder="Deja en blanco para usar los valores de la empresa"></textarea></label><label>Instrucción de decisión <span class="helper">Vacío usa la instrucción de la empresa.</span><input name="instruction_decision" maxlength="250" placeholder="Pregunta opcional para la decisión" /></label><label>Instrucción de rango <span class="helper">Vacío usa la instrucción de la empresa.</span><input name="instruction_rank" maxlength="250" placeholder="Pregunta opcional para el rango" /></label><label>Opciones para esta solicitud <span class="helper">Separados por comas; vacío usa los valores predeterminados.</span><input name="options" placeholder="aprobar, revision_manual, rechazar" /></label><label>Niveles para esta solicitud <span class="helper">Separados por comas; vacío usa los valores predeterminados.</span><input name="rank_limits" placeholder="muy_bajo, bajo, medio, alto" /></label><div class="field-span row"><button class="button" id="run-test">Ejecutar prueba</button><span id="test-time" class="small muted"></span></div></form></div><div class="panel"><div class="panel-head"><h3>Respuesta del modelo</h3><span class="muted small">Respuesta de Laya en español</span></div><pre id="test-response">Ejecuta una prueba para ver la respuesta del modelo.</pre></div></div></section>
      <section id="settings" class="content"><div class="eyebrow">Control de datos</div><h1>Configuración</h1><p class="section-description">Elige si se guardarán los historiales crediticios para un futuro ajuste del modelo. El número de solicitudes, sus tiempos y el estado del modelo se registran siempre.</p><div class="panel" style="max-width:700px"><div class="row" style="justify-content:space-between"><div><h3 style="margin-bottom:6px">Guardar el historial crediticio de las solicitudes</h3><p class="small" style="margin-bottom:0">Solo afecta a solicitudes nuevas. Los historiales se guardan en SQLite cuando está activado.</p></div><label class="switch" aria-label="Guardar historial"><input id="history-toggle" type="checkbox" /><span class="slider"></span></label></div><div id="settings-message" class="small" style="margin-top:14px"></div></div></section>
    </main>
  </div>
  <script>
    const $ = (s) => document.querySelector(s);
    let companies = [], selectedCompany = 'default';
    function showAuth(change = false) { $('#auth').classList.remove('hidden'); $('#app').classList.add('hidden'); $('#login-view').classList.toggle('hidden', change); $('#password-view').classList.toggle('hidden', !change); }
    function showApp() { $('#auth').classList.add('hidden'); $('#app').classList.remove('hidden'); loadAll(); }
    async function api(path, options = {}) { const res = await fetch(path, { ...options, headers:{ 'content-type':'application/json', ...options.headers } }); const data = await res.json().catch(() => ({})); if (!res.ok) throw new Error(data.error || data.detail || `HTTP ${res.status}`); return data; }
    async function init() { const state = await api('/api/auth/me'); if (!state.authenticated) showAuth(); else if (state.must_change_password) showAuth(true); else showApp(); }
    $('#login-form').addEventListener('submit', async e => { e.preventDefault(); const form = new FormData(e.target); try { const x = await api('/api/auth/login',{method:'POST',body:JSON.stringify(Object.fromEntries(form))}); $('#auth-message').textContent=''; if(x.must_change_password) showAuth(true); else showApp(); } catch(err) { $('#auth-message').innerHTML=`<div class="notice error">${escapeHtml(err.message)}</div>`; } });
    $('#password-form').addEventListener('submit', async e => { e.preventDefault(); try { await api('/api/auth/password',{method:'POST',body:JSON.stringify(Object.fromEntries(new FormData(e.target)))}); $('#auth-message').textContent=''; showApp(); } catch(err) { $('#auth-message').innerHTML=`<div class="notice error">${escapeHtml(err.message)}</div>`; } });
    $('#logout').addEventListener('click',async()=>{await api('/api/auth/logout',{method:'POST'});showAuth();});
    document.querySelectorAll('.nav button').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x===button));document.querySelectorAll('.content').forEach(x=>x.classList.toggle('active',x.id===button.dataset.tab));if(button.dataset.tab==='overview')loadDashboard();}));
    function localizeResponse(value) {
      const keys = {answers:'respuestas',decision:'decisión',rank:'rango',choice:'elección',score:'puntaje',confidence:'confianza',answer_confidence:'confianza_de_respuesta',probabilities:'probabilidades',routing:'enrutamiento',model:'modelo',reason:'motivo',usage:'uso',input_tokens:'tokens_de_entrada',output_tokens:'tokens_de_salida',latency_ms:'latencia_ms',legend:'niveles',action:'acción',abstention:'abstención',abstention_threshold:'umbral_de_abstención',low_confidence:'confianza_baja',option_order:'orden_de_opciones',device:'dispositivo'};
      const labels = {approve:'aprobar',manual_review:'revisión manual',revision_manual:'revisión manual',decline:'rechazar',very_low:'muy bajo',muy_bajo:'muy bajo',low:'bajo',medium:'medio',high:'alto',very_high:'muy alto',muy_alto:'muy alto',english:'inglés',multilingual:'multilingüe',true:'sí',false:'no'};
      if (Array.isArray(value)) return value.map(localizeResponse);
      if (value && typeof value === 'object') return Object.fromEntries(Object.entries(value).map(([key,item])=>[keys[key] || labels[key] || key, localizeResponse(item)]));
      return typeof value === 'string' ? labels[value] || value : value;
    }
    function escapeHtml(value) { return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    async function loadAll() { await Promise.all([loadDashboard(),loadCompanies(),loadSettings()]); }
    async function loadDashboard() { try { const data=await api('/api/dashboard'); const s=data.summary; $('#total-requests').textContent=Number(s.total||0).toLocaleString(); $('#success-rate').textContent=s.total?`${Math.round(100*s.successful/s.total)}%`:'—'; $('#avg-latency').textContent=s.avg_latency==null?'—':`${s.avg_latency} ms`; $('#input-tokens').textContent=Number(s.input_tokens||0).toLocaleString(); const h=data.health.at(-1); const status=$('#model-status'); status.classList.toggle('down',!h||h.status!=='up'); status.querySelector('span').textContent=h?.status==='up'?'Modelo disponible':'Modelo no disponible'; const map=new Map(data.traffic.map(x=>[x.hour,x])); const hours=Array.from({length:24},(_,i)=>{const d=new Date(Date.now()-(23-i)*3600000);return `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${String(d.getUTCDate()).padStart(2,'0')} ${String(d.getUTCHours()).padStart(2,'0')}:00`;}); const max=Math.max(1,...data.traffic.map(x=>x.count)); $('#traffic-bars').innerHTML=hours.map(x=>{const d=map.get(x);return `<div class="bar-wrap" title="${x}: ${d?.count||0} solicitudes"><div class="bar ${d?.errors?'error':''}" style="height:${Math.max(2,(d?.count||0)/max*100)}%"></div></div>`}).join(''); $('#health-chart').innerHTML=Array.from({length:60},(_,i)=>{const x=data.health.slice(-60)[i];return `<div class="health-stick ${x?x.status==='up'?'':'down':'empty'}" title="${x?`${x.recorded_at} · ${x.status==='up'?'disponible':'no disponible'}`:'Sin muestra'}"></div>`}).join(''); $('#recent-rows').innerHTML=data.recent.length?data.recent.map(x=>`<tr><td>${escapeHtml(new Date(x.recorded_at.replace(' ','T')+'Z').toLocaleString('es-EC'))}</td><td>${escapeHtml(x.company==='default'?'Predeterminada':x.company)}</td><td>${escapeHtml(({decision:'decisión',rank:'rango',both:'ambos'})[x.mode] || x.mode)}</td><td><span class="pill ${x.status>=400?'bad':''}">${x.status}</span></td><td>${x.latency_ms} ms</td><td>${x.input_tokens}</td></tr>`).join(''):'<tr><td colspan="6" class="muted">Todavía no hay solicitudes. Ejecuta una prueba para comenzar.</td></tr>'; } catch(err) { console.error(err); } }
    async function loadCompanies() { try { companies=await api('/api/companies'); $('#company-list').innerHTML=companies.map(x=>`<button type="button" data-company="${escapeHtml(x.name)}" class="${x.name===selectedCompany?'active':''}">${escapeHtml(x.name==='default'?'Predeterminada':x.name)}</button>`).join(''); $('#test-company').innerHTML=companies.map(x=>`<option value="${escapeHtml(x.name)}">${escapeHtml(x.name==='default'?'Predeterminada':x.name)}</option>`).join(''); $('#company-list').querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>selectCompany(b.dataset.company))); selectCompany(companies.some(x=>x.name===selectedCompany)?selectedCompany:'default'); updateTestInstructionHints(); } catch(err) { console.error(err); } }
    function selectCompany(name) { selectedCompany=name; const x=companies.find(c=>c.name===name); if(!x)return; $('#company-rules').value=x.rules; $('#company-instruction-decision').value=x.instruction_decision; $('#company-instruction-rank').value=x.instruction_rank; $('#test-company').value=name; updateTestInstructionHints(); $('#company-options').value=x.options.join('\n'); $('#company-ranks').value=x.rank_limits.join('\n'); $('#company-list').querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.company===name)); }
    function updateTestInstructionHints() { const company=companies.find(x=>x.name===$('#test-company').value); $('#test-form [name=instruction_decision]').placeholder=company?.instruction_decision || 'Usar instrucción predeterminada'; $('#test-form [name=instruction_rank]').placeholder=company?.instruction_rank || 'Usar instrucción predeterminada'; }
    $('#test-company').addEventListener('change',updateTestInstructionHints);
    $('#create-company').addEventListener('submit',async e=>{e.preventDefault();try{const name=new FormData(e.target).get('name');await api('/api/companies',{method:'POST',body:JSON.stringify({name})});selectedCompany=name;e.target.reset();await loadCompanies();$('#company-message').textContent='Empresa creada.';}catch(err){$('#company-message').textContent=err.message;}});
    $('#company-form').addEventListener('submit',async e=>{e.preventDefault();try{await api(`/api/companies/${encodeURIComponent(selectedCompany)}`,{method:'PUT',body:JSON.stringify({rules:$('#company-rules').value,instruction_decision:$('#company-instruction-decision').value,instruction_rank:$('#company-instruction-rank').value,options:$('#company-options').value.split('\n').map(x=>x.trim()).filter(Boolean),rank_limits:$('#company-ranks').value.split('\n').map(x=>x.trim()).filter(Boolean)})});$('#company-message').textContent='Valores predeterminados guardados.';await loadCompanies();}catch(err){$('#company-message').textContent=err.message;}});
    async function loadSettings(){try{const x=await api('/api/settings/history');$('#history-toggle').checked=x.save_history;}catch(err){console.error(err)}}
    $('#history-toggle').addEventListener('change',async e=>{try{await api('/api/settings/history',{method:'PUT',body:JSON.stringify({save_history:e.target.checked})});$('#settings-message').textContent=e.target.checked?'El guardado del historial está activado.':'El guardado del historial está desactivado.';}catch(err){e.target.checked=!e.target.checked;$('#settings-message').textContent=err.message;}});
    $('#test-form').addEventListener('submit',async e=>{e.preventDefault();const form=new FormData(e.target);const payload={company:form.get('company'),output:form.get('output')};for(const key of ['state','history','rules','instruction_decision','instruction_rank']){const value=String(form.get(key)||'');if(value)payload[key]=value;}for(const key of ['options','rank_limits']){const value=String(form.get(key)||'');if(value)payload[key]=value.split(',').map(x=>x.trim()).filter(Boolean);}$('#run-test').disabled=true;$('#test-response').textContent='Ejecutando Laya…';const start=performance.now();try{const result=await api('/api/test/decide',{method:'POST',body:JSON.stringify(payload)});$('#test-response').textContent=JSON.stringify({modelo:localizeResponse(result.routing?.model || result.model || 'multilingual'),respuestas:localizeResponse(result.answers || {}),uso:localizeResponse(result.usage || {})},null,2);}catch(err){$('#test-response').textContent=JSON.stringify({error:err.message},null,2);}finally{$('#run-test').disabled=false;$('#test-time').textContent=`${Math.round(performance.now()-start)} ms`;loadDashboard();}});
    init(); setInterval(()=>{if(!$('#app').classList.contains('hidden'))loadDashboard()},60000);
  </script>
</body>
</html>
